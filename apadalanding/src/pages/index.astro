---
import MainLayout from '../layouts/MainLayout.astro';
import { Hero } from '../components/sections/Hero';
import { Features } from '../components/sections/Features';
import { Button } from '../components/ui/Button';
import { LANDING_CONTENT } from '../core/constants/landing-content';

const { podcast, testimonials, cta } = LANDING_CONTENT;

const delayClasses = ['delay-100', 'delay-200', 'delay-300', 'delay-400', 'delay-500'];
---

<MainLayout>
  {/* Hero Section */}
  <Hero client:load />

  {/* Pillars and Resources Section */}
  <Features client:visible />

  {/* Featured Podcast Section */}
  <section class="py-24 overflow-hidden relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="glass bg-white/40 rounded-[3rem] p-8 md:p-16 border border-white relative shadow-xl hover:shadow-2xl transition-shadow duration-500">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          
          <div class="order-2 lg:order-1 animate-fade-in-up">
             <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-100/80 backdrop-blur-sm text-orange-700 text-xs font-extrabold uppercase tracking-widest mb-6 border border-orange-200">
                {podcast.tag}
             </div>
             <h3 class="text-blue-600 text-xl font-black mb-2 tracking-tight">{podcast.subtitle}</h3>
             <h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-6 leading-tight">{podcast.title}</h2>
             <p class="text-slate-600 text-lg md:text-xl mb-10 leading-relaxed font-light">
                {podcast.description}
             </p>
             <Button variant="secondary" size="lg" className="shadow-md hover:shadow-lg transition-shadow">{podcast.button}</Button>
          </div>

          <div class="order-1 lg:order-2 flex justify-center">
            <div class="relative animate-float">
              <div class="absolute inset-0 bg-blue-400/20 rounded-full blur-[80px] animate-pulse" />
              <div class="relative w-72 h-72 lg:w-80 lg:h-80 bg-slate-900 rounded-[3rem] flex flex-col items-center justify-center shadow-2xl overflow-hidden group border border-slate-700">
                <div class="absolute inset-0 bg-gradient-to-tr from-blue-600/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700" />
                <span class="text-8xl mb-6 transform group-hover:scale-110 transition-transform duration-500 drop-shadow-xl z-10">🎧</span>
                <div class="flex gap-1.5 items-end h-10 z-10">
                  <div class="w-2 bg-blue-400 rounded-full animate-[bounce_1s_infinite] shadow-lg shadow-blue-500/50 h-2/5 delay-100" />
                  <div class="w-2 bg-blue-400 rounded-full animate-[bounce_1s_infinite] shadow-lg shadow-blue-500/50 h-3/4 delay-200" />
                  <div class="w-2 bg-blue-400 rounded-full animate-[bounce_1s_infinite] shadow-lg shadow-blue-500/50 h-1/2 delay-300" />
                  <div class="w-2 bg-blue-400 rounded-full animate-[bounce_1s_infinite] shadow-lg shadow-blue-500/50 h-4/5 delay-400" />
                  <div class="w-2 bg-blue-400 rounded-full animate-[bounce_1s_infinite] shadow-lg shadow-blue-500/50 h-3/5 delay-500" />
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  {/* Community Testimonials Section */}
  <section class="py-24 relative bg-slate-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20 animate-fade-in-up">
        <h2 class="text-4xl md:text-5xl font-black text-slate-900">{testimonials.title}</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-10">
        {testimonials.items.map((testimonial, index) => (
          <div class={`glass p-10 md:p-12 rounded-[3rem] shadow-xl shadow-slate-200/50 border border-white relative group hover:bg-white transition-colors duration-500 animate-fade-in-up ${delayClasses[index] || ''}`}>
            <div class="absolute top-8 right-12 text-slate-200 text-8xl font-serif pointer-events-none group-hover:text-blue-50 transition-colors duration-500">“</div>
            
            <div class="flex text-orange-400 mb-8 drop-shadow-sm">
              {[...Array(testimonial.rating)].map(() => (
                <svg class="w-6 h-6 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            
            <p class="text-xl md:text-2xl text-slate-700 font-medium mb-10 leading-relaxed relative z-10 italic">
              "{testimonial.text}"
            </p>
            
            <div class="flex items-center gap-5 mt-auto">
              <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-teal-400 rounded-full flex items-center justify-center font-bold text-white text-2xl shadow-lg shadow-blue-500/30 ring-4 ring-white">
                {testimonial.name[0]}
              </div>
              <div>
                <h4 class="font-bold text-slate-900 text-lg md:text-xl">{testimonial.name}</h4>
                <p class="text-sm md:text-base text-slate-500 font-medium">{testimonial.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Final Call to Action Section */}
  <section class="py-24 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 relative z-10">
      <div class="bg-gradient-to-br from-blue-600 via-blue-700 to-teal-600 p-12 md:p-24 rounded-[4rem] text-white text-center shadow-2xl shadow-blue-900/40 relative overflow-hidden group">
        
        <div class="absolute inset-0 opacity-20 mix-blend-overlay pointer-events-none">
           <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-white rounded-full blur-[120px] animate-blob" />
           <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-orange-300 rounded-full blur-[120px] animate-blob delay-200" />
        </div>
        
        <h2 class="text-4xl md:text-6xl lg:text-7xl font-black mb-8 leading-[1.1] relative z-10">
          {cta.title}
        </h2>
        
        <p class="text-blue-100 text-xl md:text-2xl mb-12 max-w-3xl mx-auto relative z-10 font-light">
          {cta.description}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-6 justify-center relative z-10">
          <a href={cta.primaryLink} class="group/btn relative inline-flex justify-center items-center px-10 py-5 text-lg font-bold text-white bg-orange-500 hover:bg-orange-600 rounded-2xl shadow-xl shadow-orange-500/40 transition-all duration-300 transform hover:-translate-y-1 overflow-hidden">
            <div class="absolute inset-0 w-full h-full bg-white/20 scale-x-0 group-hover/btn:scale-x-100 origin-left transition-transform duration-500 ease-out" />
            <span class="relative z-10">{cta.primaryButton}</span>
          </a>
          
          <Button variant="secondary" size="lg" className="!bg-white/10 backdrop-blur-md !text-white border border-white/30 hover:!bg-white hover:!text-blue-900 shadow-xl transition-all duration-300 !px-10 !py-5 !text-lg !rounded-2xl">
            {cta.secondaryButton}
          </Button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>