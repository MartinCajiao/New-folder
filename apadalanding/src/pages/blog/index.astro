---
import MainLayout from '../../layouts/MainLayout.astro';
import { blogService } from '../../services/content';
import { ArrowRight, Calendar, User } from 'lucide-react';

const posts = await blogService.getAllPosts();
const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const formatDate = (date: Date | string) => {
  return new Date(date).toLocaleDateString('es-EC', {
    year: 'numeric', 
    month: 'long', 
    day: 'numeric'
  });
};

const getTagColor = (tag: string) => {
  const colors: Record<string, string> = {
    'Legal': 'bg-red-100 text-red-700 border-red-200',
    'Educación': 'bg-blue-100 text-blue-700 border-blue-200',
    'Comunidad': 'bg-green-100 text-green-700 border-green-200',
    'Victoria': 'bg-purple-100 text-purple-700 border-purple-200',
    'default': 'bg-slate-100 text-slate-700 border-slate-200'
  };
  return colors[tag] || colors['default'];
};
---

<MainLayout title="Blog y Recursos | APADA">
  {/* Blog Header */}
  <section class="relative bg-slate-900 pt-32 pb-24 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-600/30 rounded-full blur-[120px] -mr-48 -mt-48 animate-pulse" />
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-teal-500/20 rounded-full blur-[120px] -ml-48 -mb-48 delay-200 animate-blob" />
      <div class="absolute inset-0 bg-[url('/pattern.svg')] opacity-10" />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-block px-5 py-2 rounded-full glass-dark text-blue-300 text-xs font-bold uppercase tracking-widest mb-6 border border-white/10 shadow-lg">
        Actualidad APADA
      </span>
      <h1 class="text-5xl md:text-7xl font-black text-white mb-6 tracking-tight">
        Blog y <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-teal-300">Recursos</span>
      </h1>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed font-light">
        Crónicas de nuestras luchas legales, convenios educativos y guías para la comunidad autista en Ecuador.
      </p>
    </div>
  </section>

  <section class="py-24 bg-slate-50 min-h-screen relative -mt-8 rounded-t-[3rem] z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Featured Post */}
      {featuredPost && (
        <div class="mb-24 animate-fade-in-up">
          <a href="#" class="block group relative glass p-2 rounded-[3rem] shadow-2xl hover:shadow-blue-900/20 transition-all duration-500">
            <div class="grid lg:grid-cols-2 rounded-[2.5rem] overflow-hidden bg-white">
              
              <div class="bg-gradient-to-br from-blue-900 via-blue-800 to-slate-900 p-12 lg:p-16 flex flex-col justify-center text-white relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full blur-3xl" />
                
                <div class="flex gap-2 mb-8 relative z-10">
                  {featuredPost.tags?.map(tag => (
                    <span class="px-4 py-1.5 bg-white/10 backdrop-blur-md rounded-full text-xs font-bold uppercase tracking-widest border border-white/20">
                      {tag}
                    </span>
                  ))}
                </div>
                
                <h2 class="text-3xl md:text-5xl font-black mb-6 leading-tight group-hover:text-blue-300 transition-colors duration-300 relative z-10">
                  {featuredPost.title}
                </h2>
                
                <p class="text-blue-100/80 text-lg mb-10 line-clamp-3 leading-relaxed font-light relative z-10">
                  {featuredPost.description}
                </p>
                
                <div class="flex items-center gap-6 mt-auto pt-8 border-t border-white/10 relative z-10">
                  <div class="flex items-center gap-2">
                    <User class="w-5 h-5 text-blue-400" />
                    <span class="font-bold tracking-wide">{featuredPost.author}</span>
                  </div>
                  <div class="flex items-center gap-2 text-blue-200/60">
                    <Calendar class="w-5 h-5" />
                    <span class="text-sm font-medium">{formatDate(featuredPost.pubDate)}</span>
                  </div>
                </div>
              </div>
              
              <div class="bg-slate-100 min-h-[400px] flex items-center justify-center text-8xl relative overflow-hidden group-hover:scale-105 transition-transform duration-700">
                <div class="absolute inset-0 bg-gradient-to-tr from-blue-100 to-orange-50 opacity-50" />
                <span class="relative z-10 drop-shadow-2xl">📰</span>
              </div>
              
            </div>
          </a>
        </div>
      )}

      {/* Grid of Remaining Posts */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
        {remainingPosts.map((post, index) => (
          <a href="#" class={`block group h-full animate-fade-in-up delay-${(index % 3 + 1) * 100}`}>
            <div class="glass h-full p-8 rounded-[2.5rem] shadow-lg shadow-slate-200/50 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-white flex flex-col relative overflow-hidden bg-white/60">
              
              <div class="flex gap-2 mb-6">
                {post.tags?.map((tag) => (
                  <span class={`px-3 py-1 text-[10px] font-black rounded-lg uppercase tracking-widest border ${getTagColor(tag)}`}>
                    {tag}
                  </span>
                ))}
              </div>
              
              <h3 class="text-2xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-4 leading-snug">
                {post.title}
              </h3>
              
              <p class="text-slate-600 mb-8 line-clamp-3 leading-relaxed">
                {post.description}
              </p>
              
              <div class="mt-auto pt-6 border-t border-slate-100 flex justify-between items-center text-xs font-bold text-slate-400 uppercase tracking-widest">
                <div class="flex items-center gap-1.5">
                  <User class="w-4 h-4" />
                  <span>{post.author}</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <Calendar class="w-4 h-4" />
                  <span>{formatDate(post.pubDate)}</span>
                </div>
              </div>

              {/* Hover Indicator */}
              <div class="absolute bottom-8 right-8 w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 opacity-0 group-hover:opacity-100 transform translate-x-4 group-hover:translate-x-0 transition-all duration-300">
                <ArrowRight class="w-5 h-5" />
              </div>

            </div>
          </a>
        ))}
      </div>

      {/* Call to Action for Writers */}
      <div class="mt-32 relative overflow-hidden rounded-[4rem]">
        <div class="absolute inset-0 bg-gradient-to-r from-orange-500 to-orange-400" />
        <div class="absolute inset-0 bg-[url('/pattern.svg')] opacity-20 mix-blend-overlay" />
        
        <div class="relative z-10 p-12 md:p-20 text-center flex flex-col items-center">
          <div class="w-20 h-20 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center text-white mb-8">
            <span class="text-4xl">✍️</span>
          </div>
          <h3 class="text-3xl md:text-5xl font-black text-white mb-6">¿Tienes una historia que contar?</h3>
          <p class="text-orange-100 text-xl mb-10 max-w-2xl mx-auto font-light leading-relaxed">
            Queremos dar voz a las familias y personas autistas. Si quieres colaborar con un artículo, compártenos tus vivencias.
          </p>
          <a 
            href="mailto:info@apadadelecuador.org" 
            class="inline-flex items-center gap-2 bg-white text-orange-600 px-10 py-4 rounded-2xl font-bold hover:bg-orange-50 hover:scale-105 transition-all duration-300 shadow-xl shadow-orange-900/20"
          >
            Contactar a Redacción <ArrowRight class="w-5 h-5" />
          </a>
        </div>
      </div>
      
    </div>
  </section>
</MainLayout>