---
import MainLayout from '../layouts/MainLayout.astro';
import { DonationCard } from '../components/sections/DonationCard';
import { SITE_INFO, IMPACT_METRICS } from '../core/constants/site-info';

const pageTitle = "Donaciones y Voluntariado";
const pageDescription = "Colabora con APADA del Ecuador. Tu apoyo nos permite seguir brindando recursos, asesoría legal y actividades inclusivas.";
---

<MainLayout title={pageTitle} description={pageDescription}>
  
  {/* Hero and Impact Section */}
  <section class="relative bg-blue-600 pt-32 pb-24 text-white overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-white/20 rounded-full blur-[120px] -mr-48 -mt-48 animate-pulse" />
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-teal-400/20 rounded-full blur-[120px] -ml-48 -mb-48" />
      <div class="absolute inset-0 bg-[url('/pattern.svg')] opacity-5" />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 animate-fade-in-up">
        <span class="inline-block px-5 py-2 rounded-full bg-blue-500/50 backdrop-blur-md text-white text-xs font-bold uppercase tracking-widest mb-6 border border-blue-400/30">
          Únete a la Causa
        </span>
        <h1 class="text-5xl md:text-7xl font-black mb-6 tracking-tight">Colabora con <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-300 to-orange-500">APADA</span></h1>
        <p class="text-blue-100 text-xl md:text-2xl max-w-3xl mx-auto font-light leading-relaxed">
          Cada acción cuenta. Juntos estamos construyendo una sociedad más inclusiva y respetuosa para las personas con autismo en Ecuador.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8">
        {IMPACT_METRICS.map((metric, index) => (
          <div class={`text-center p-8 bg-white/10 rounded-[2rem] backdrop-blur-md border border-white/20 hover:bg-white/20 transition-colors duration-300 animate-fade-in-up delay-${(index + 1) * 100}`}>
            <span class="block text-5xl md:text-6xl font-black mb-3 text-transparent bg-clip-text bg-gradient-to-br from-white to-blue-200 drop-shadow-sm">
              {metric.value}
            </span>
            <span class="text-sm md:text-base font-bold text-blue-100 uppercase tracking-widest">
              {metric.label}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Institutional Purpose Section */}
  <section class="py-24 relative overflow-hidden bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-stretch">
        <div class="glass p-12 rounded-[3rem] border border-white shadow-xl hover:shadow-2xl transition-shadow duration-500 relative group overflow-hidden">
          <div class="absolute top-0 left-0 w-2 h-full bg-gradient-to-b from-orange-400 to-orange-600" />
          <div class="absolute top-0 right-0 w-64 h-64 bg-orange-100 rounded-bl-full -mr-32 -mt-32 opacity-50 group-hover:scale-110 transition-transform duration-500" />
          <h2 class="text-3xl font-black text-slate-900 mb-6 relative z-10">
            Nuestra Misión
          </h2>
          <p class="text-lg text-slate-600 leading-relaxed font-medium relative z-10">
            {SITE_INFO.mission}
          </p>
        </div>
        <div class="glass p-12 rounded-[3rem] border border-white shadow-xl hover:shadow-2xl transition-shadow duration-500 relative group overflow-hidden">
          <div class="absolute top-0 left-0 w-2 h-full bg-gradient-to-b from-blue-600 to-teal-500" />
          <div class="absolute top-0 right-0 w-64 h-64 bg-blue-100 rounded-bl-full -mr-32 -mt-32 opacity-50 group-hover:scale-110 transition-transform duration-500" />
          <h2 class="text-3xl font-black text-slate-900 mb-6 relative z-10">
            Nuestra Visión
          </h2>
          <p class="text-lg text-slate-600 leading-relaxed font-medium relative z-10">
            {SITE_INFO.vision}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Donation Mechanism Section */}
  <section class="py-32 relative bg-white">
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-50 rounded-full blur-[120px]" />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <DonationCard client:load />

      <div class="mt-20 text-center max-w-2xl mx-auto glass p-8 rounded-[2rem] border border-white shadow-lg">
        <h4 class="text-xl font-bold text-slate-900 mb-4">¿Deseas colaborar como voluntario?</h4>
        <p class="text-slate-600 mb-6">
          Si no puedes aportar económicamente, tu tiempo y habilidades son igual de valiosos. Únete a nuestro equipo de voluntarios.
        </p>
        <a href="https://wa.me/593996062600" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-green-500 to-green-400 text-white font-bold rounded-xl shadow-lg shadow-green-500/30 hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
          <span class="text-2xl">💬</span> Contáctanos por WhatsApp
        </a>
      </div>
    </div>
  </section>
</MainLayout>