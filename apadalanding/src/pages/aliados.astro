---
import MainLayout from '../layouts/MainLayout.astro';
import { Card } from '../components/ui/Card';
import type { Aliado } from '../core/types';

// Datos de los aliados (esto podría venir de una API en el futuro, por ahora es estático)
const aliados: Aliado[] = [
  {
    nombre: "Universidad Central del Ecuador",
    logoUrl: "/logos/uce.png", // Deberás subir esto a public/logos/
    categoria: "Educativo",
    webUrl: "https://www.uce.edu.ec"
  },
  {
    nombre: "Fe y Alegría Ecuador",
    logoUrl: "/logos/fe-y-alegria.png", // Deberás subir esto a public/logos/
    categoria: "Educativo",
    webUrl: "https://www.feyalegria.org.ec"
  },
  // Puedes agregar más objetos aquí siguiendo la misma estructura
];
---

<MainLayout 
  title="Nuestros Aliados" 
  description="Conoce a las instituciones y organizaciones que fortalecen nuestro compromiso con la comunidad autista."
>
  <section class="bg-blue-50/40 border-b border-blue-100 py-16 md:py-24 relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="text-blue-700 font-bold tracking-wider uppercase text-sm mb-4 block">
        Red de Apoyo Institucional
      </span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-6">
        Juntos Hacemos la Diferencia
      </h1>
      <p class="text-lg md:text-xl text-slate-600 leading-relaxed mb-10">
        En APADA creemos en el poder del trabajo en red. Gracias a nuestros aliados, podemos ampliar nuestro impacto, brindar recursos educativos, asesoría legal y actividades inclusivas para personas con autismo y sus familias. Cada institución aliada fortalece nuestro compromiso con la comunidad.
      </p>
      
      <a 
        href="mailto:info@apadadelecuador.org?subject=Quiero%20ser%20aliado%20de%20APADA"
        class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white bg-orange-500 hover:bg-orange-600 rounded-xl shadow-lg shadow-orange-500/30 transition-all duration-300 transform hover:-translate-y-0.5"
      >
        Quiero ser un aliado
      </a>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Nuestros Aliados</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Estas instituciones y organizaciones son parte esencial del impacto que logramos día a día en la vida de las personas con autismo y sus familias.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
        {aliados.map((aliado) => (
          <a 
            href={aliado.webUrl || '#'} 
            target={aliado.webUrl ? "_blank" : "_self"}
            rel={aliado.webUrl ? "noopener noreferrer" : ""}
            class="block group outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-2xl"
          >
            <Card hoverable className="h-full flex flex-col items-center justify-center p-8 bg-white border-slate-100 transition-all duration-300 group-hover:border-blue-200 group-hover:shadow-blue-900/5">
              <div class="w-full aspect-[3/2] flex items-center justify-center overflow-hidden mb-4">
                <img 
                  src={aliado.logoUrl} 
                  alt={`Logo de ${aliado.nombre}`} 
                  class="max-h-24 w-auto object-contain grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500 transform group-hover:scale-105"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="hidden text-center items-center justify-center w-full h-full text-slate-400 font-medium text-sm p-4 bg-slate-50 rounded-xl">
                  {aliado.nombre}
                </div>
              </div>
              <span class="text-sm font-semibold text-slate-700 text-center line-clamp-2">
                {aliado.nombre}
              </span>
            </Card>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>